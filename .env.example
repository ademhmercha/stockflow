# =============================================================================
# StockFlow — Variables d'environnement
#
# Ce fichier est le référentiel consolidé (utilisé notamment par
# infra/docker-compose.yml). Pour le dev local hors Docker :
#   - copier la section BACKEND dans apps/backend/.env
#   - copier la section FRONTEND dans apps/frontend/.env
# Pour Docker Compose : copier ce fichier en infra/.env
# Ne jamais committer un fichier .env réel (seul .env.example est versionné).
# =============================================================================

# --------------------------- BACKEND ---------------------------------------

# Environnement d'exécution : development | test | production
NODE_ENV=development

# Port d'écoute de l'API Express
PORT=4000

# URI de connexion MongoDB
# - docker-compose : mongodb://mongo:27017/stockflow
# - local sans Docker : mongodb://localhost:27017/stockflow
MONGO_URI=mongodb://localhost:27017/stockflow

# Secrets JWT — générer des valeurs aléatoires fortes (ex: `openssl rand -hex 32`)
# et NE JAMAIS les committer en clair.
JWT_SECRET=change-me-please-32-chars-minimum
JWT_REFRESH_SECRET=change-me-too-please-32-chars-minimum

# Durée de validité des tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Montant du timbre fiscal tunisien (en DT), appliqué une fois par facture.
# Ce montant est fixé par la loi de finances et change chaque année : il est
# donc piloté ici plutôt que codé en dur dans l'application.
TIMBRE_FISCAL_MONTANT=1

# Origine autorisée pour les requêtes CORS (URL du frontend)
CORS_ORIGIN=http://localhost:5173

# --------------------------- FRONTEND ---------------------------------------

# URL de base de l'API consommée par le frontend Vite
VITE_API_URL=http://localhost:4000/api
