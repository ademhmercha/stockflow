# --- Étape de build ---
FROM node:20-alpine AS build
WORKDIR /app

# Chromium pour Puppeteer (génération PDF des factures) : nécessaire ici car
# docker-compose utilise cette étape "build" comme conteneur de dev (target:
# build) avec hot-reload — pas seulement comme étape intermédiaire vers la
# production. Le téléchargement automatique du Chromium intégré à Puppeteer
# ne fonctionne pas de façon fiable sur Alpine (musl vs glibc), d'où l'usage
# du paquet système via apk, comme pour l'étape production (apt).
RUN apk add --no-cache chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

COPY apps/backend/package*.json ./
RUN npm ci

COPY apps/backend/ ./
RUN npm run build

# --- Étape de production ---
FROM node:20-slim AS production
WORKDIR /app
ENV NODE_ENV=production

# Puppeteer a besoin de Chromium et de ses dépendances système pour générer les PDF.
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

COPY apps/backend/package*.json ./
RUN npm ci --omit=dev

COPY --from=build /app/dist ./dist

EXPOSE 4000
USER node

CMD ["node", "dist/server.js"]
